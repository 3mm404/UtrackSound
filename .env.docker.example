APP_NAME=Utrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8088

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=utrack
DB_USERNAME=utrack
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-root

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=utrack
REVERB_APP_KEY=cambia-esta-clave-reverb
REVERB_APP_SECRET=cambia-este-secreto-reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
ENGINE_WEBSOCKET_URL=wss://tu-dominio.com/app/cambia-esta-clave-reverb
ENGINE_MEDIA_URL=https://tu-dominio.com

FILESYSTEM_DISK=local
MAIL_MAILER=log

# Compose ejecuta migraciones solo en el servicio app.
