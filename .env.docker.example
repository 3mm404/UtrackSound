APP_NAME=Utrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=utrack
DB_USERNAME=utrack
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-root

SESSION_DRIVER=database
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=utrack
REVERB_APP_KEY=cambia-esta-clave-reverb
REVERB_APP_SECRET=cambia-este-secreto-reverb
REVERB_HOST=tu-dominio.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
ENGINE_WEBSOCKET_URL=wss://tu-dominio.com/app/cambia-esta-clave-reverb

FILESYSTEM_DISK=local
MAIL_MAILER=log

# El contenedor ejecuta las migraciones al iniciar cuando vale true.
RUN_MIGRATIONS=true
